{
  "name": "t360-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM core built around the LinkedIn qualification engine. Runs on Postgres (Railway) via `pg`, used only by lib/postgres.mjs. `@modelcontextprotocol/sdk` and `zod` back the read-only MCP server at /mcp (lib/mcp.mjs).",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node test.mjs",
    "lint": "node test.mjs",
    "collect": "node --env-file=data/turso.env server.mjs",
    "setup": "node setup.mjs",
    "import": "node import-snapshots.mjs",
    "backup": "node backup-db.mjs",
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
